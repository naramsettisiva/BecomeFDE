# Copy to .env and fill in. NEVER commit .env.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# local | openai | anthropic | bedrock
FDEKIT_BACKEND=local

# --- aws lane -------------------------------------------------------------
# No keys here. Auth comes from IAM Identity Center: aws sso login --profile fde
AWS_PROFILE=fde
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
BEDROCK_JUDGE_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
S3_VECTOR_BUCKET=

# --- observability (Week 3) ----------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=fde-bootcamp

TAVILY_API_KEY=
HF_TOKEN=

BOOTCAMP_BUDGET_USD=100
FDE_BUDGET_USD=50
